{
  "name": "probe-planner",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-scripts": "5.0.1",
    "three": "^0.183.2",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "prestart": "node scripts/fix_react_warnings.js",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:frontend": "react-scripts test --watchAll=false",
    "lint": "eslint src --max-warnings=0",
    "lint:i18n": "node --no-warnings scripts/check_i18n_guard.js",
    "quality": "npm run lint && npm run lint:i18n && npm run test:frontend -- --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "eject": "react-scripts eject"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "pyright": "^1.1.389"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "unicode-bom": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
