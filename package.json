{
  "name": "probeplanner-native-upgrade",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shark04468/probeplanner.git"
  },
  "type": "module",
  "scripts": {
    "ui:install": "npm --prefix apps/ui install",
    "ui:start": "npm --prefix apps/ui start",
    "ui:build": "npm --prefix apps/ui run build",
    "ui:test": "npm --prefix apps/ui run test:frontend",
    "ui:e2e": "npm --prefix apps/ui run test:e2e",
    "backend:start": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/backend-compat/scripts/start_backend_compat.ps1",
    "backend:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/backend-compat/scripts/smoke_backend_compat.ps1",
    "backend:test": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/backend-compat/scripts/test_backend_compat.ps1",
    "mri:qc": "python apps/backend-compat/scripts/check_mri_registration_qc.py",
    "sdf:boundary": "python apps/backend-compat/scripts/check_sdf_boundary_layers.py",
    "dev:stack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start_dev_stack.ps1",
    "prepare:cases": "tsx apps/perf-gate/src/cli.ts prepare:cases",
    "perf:baseline": "tsx apps/perf-gate/src/cli.ts run --mode baseline",
    "perf:gate": "tsx apps/perf-gate/src/cli.ts run --mode gate",
    "perf:gate:backend": "tsx apps/perf-gate/src/cli.ts run --mode gate --skip-3d --backend-warmup-runs 1",
    "perf:gate:sdf": "tsx apps/perf-gate/src/cli.ts run --mode gate --skip-3d --case-group sdf-adversarial",
    "perf:gate:3d": "tsx apps/perf-gate/src/cli.ts run --mode gate --require-3d --3d-runs 3 --3d-headed",
    "perf:paper:synthetic": "cargo test -p planner-engine --test synthetic_phantom synthetic_ -- --nocapture",
    "perf:paper:replay100": "tsx apps/perf-gate/src/cli.ts run --mode baseline --skip-3d --case-group replay100 --case-limit 100 --runs 3 --backend-warmup-runs 1 --out reports/paper-replay100",
    "perf:paper:replay110": "tsx apps/perf-gate/src/cli.ts run --mode baseline --skip-3d --case-group replay100 --case-limit 110 --runs 1 --backend-warmup-runs 0 --timeout-ms 60000 --allow-failures --out reports/paper-native-replay110",
    "perf:paper:stress": "tsx apps/perf-gate/src/cli.ts run --mode baseline --skip-3d --case-group stress --case-limit 500 --runs 1 --allow-failures --out reports/paper-stress500",
    "perf:paper:ablation": "tsx apps/perf-gate/src/cli.ts run --mode baseline --skip-3d --case-group ablation --runs 1 --allow-failures --out reports/paper-ablation",
    "perf:paper:sdf": "tsx apps/perf-gate/src/cli.ts run --mode gate --skip-3d --case-group sdf-boundary --case-limit 100 --runs 1 --baseline reports/native-sdf-adversarial-strict-v2/summary.json --out reports/paper-sdf-boundary100",
    "perf:paper:compare": "tsx apps/perf-gate/src/paper/compareLegacyNative.ts",
    "perf:paper:stability": "tsx apps/perf-gate/src/paper/stabilityReplay.ts",
    "perf:paper:failure": "tsx apps/perf-gate/src/paper/failureAnalysis.ts",
    "perf:paper:trajectory": "tsx apps/perf-gate/src/paper/trajectoryAudit.ts",
    "perf:paper:targets": "tsx apps/perf-gate/src/paper/supportedTargets.ts",
    "perf:paper:phantom": "tsx apps/perf-gate/src/paper/phantomAccuracy.ts",
    "perf:paper:phantom-optimal-count": "tsx apps/perf-gate/src/paper/phantomOptimalProbeCount.ts",
    "perf:paper:repro": "tsx apps/perf-gate/src/paper/reproducibilityPack.ts",
    "perf:paper:atlas": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/backend-compat/scripts/run_allensdk_atlas_audit.ps1",
    "perf:paper:mri-qc": "powershell -NoProfile -ExecutionPolicy Bypass -File apps/backend-compat/scripts/run_mri_ccf_registration_qc.ps1",
    "perf:paper:baseline-planning": "python apps/backend-compat/scripts/benchmark_baseline_auto_planning_comparison.py",
    "perf:paper:objective-ablation": "python apps/backend-compat/scripts/benchmark_objective_constraint_ablation.py",
    "perf:paper:planning-stability": "python apps/backend-compat/scripts/benchmark_auto_planning_stability.py",
    "perf:paper:atlas-case-study": "py -3.14 apps/backend-compat/scripts/render_real_atlas_case_studies.py",
    "rust:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check_windows_rust_prereqs.ps1",
    "ci:doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify_ci_environment.ps1",
    "rust:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/rust_check.ps1",
    "engine:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run_engine.ps1",
    "example:minimal": "node scripts/run_minimal_example.mjs",
    "replay:native": "node scripts/run_native_replay.mjs",
    "desktop:check": "cargo check --manifest-path apps/desktop-tauri/src-tauri/Cargo.toml",
    "desktop:stack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start_desktop_stack.ps1",
    "desktop:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop_local_stack.ps1",
    "release:build-supplement": "python scripts/release/build_supplementary_data.py",
    "release:verify": "python scripts/release/verify_release.py",
    "release:reproduce": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/verify_clean_reproduction.ps1",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "quality": "npm run typecheck && npm test && npm run ui:test && npm --prefix apps/ui run quality && npm run ui:build && npm run backend:smoke"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
